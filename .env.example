# Set APP_ENV=preview on Vercel Preview and APP_ENV=production only for production.
APP_ENV=preview
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://your-preview-domain.vercel.app

# PostgreSQL (pooled runtime URL and direct migration/seed URL).
DATABASE_URL=postgresql://user:replace-me@host:5432/database?sslmode=require
DIRECT_URL=postgresql://user:replace-me@host:5432/database?sslmode=require

# Stripe TEST mode only. Never use an sk_live_ key for preview.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
ALLOW_LIVE_PAYMENTS=false

# Admin user created by the manual seed:demo command.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
SESSION_SECRET=replace-with-at-least-32-random-characters

# Email: console logs messages; use resend for real email delivery.
EMAIL_PROVIDER=console
RESEND_API_KEY=replace-with-resend-api-key
MAIL_FROM=RUSH <ordini@your-domain.example>

# Anti-bot: configure Cloudflare Turnstile test keys for previews.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-cloudflare-turnstile-site-key
TURNSTILE_SECRET_KEY=replace-with-cloudflare-turnstile-secret-key
TURNSTILE_MODE=live

# Distributed rate limiting is required on Vercel.
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-token

# Optional AI try-on. Keep disabled by default; mock is allowed only outside production.
TRYON_PROVIDER=mock
FAL_KEY=replace-with-fal-api-key
TRYON_MODEL_ID=fal-ai/fashn/tryon
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
TRYON_BUCKET=rush-tryon-temp
TRYON_RESULT_TTL_SECONDS=300
TRYON_COST_ESTIMATE_USD=0.075
TRYON_DAILY_LIMIT=5
TRYON_MAX_DAILY_SPEND_USD=1

# Daily Vercel cron authentication.
CRON_SECRET=replace-with-a-long-random-cron-secret

# Presale configuration.
PRESALE_THRESHOLD=15
PRESALE_MAX_QUANTITY=5
