{
  "name": "rush-presale",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/prisma-cli.ts migrate deploy",
    "db:dev": "tsx scripts/prisma-cli.ts migrate dev",
    "db:studio": "tsx scripts/prisma-cli.ts studio",
    "admin:setup": "tsx scripts/setup-local-admin.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "typecheck": "tsc --noEmit",
    "seed:staging": "tsx scripts/seed-staging.ts",
    "test:http": "tsx scripts/test-http.ts",
    "staging:credentials": "tsx scripts/staging-credentials.ts",
    "staging:check": "tsx scripts/staging-check.ts",
    "db:validate": "tsx scripts/prisma-cli.ts validate",
    "test:migration": "tsx scripts/test-migration.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@next/env": "16.4.2",
    "@prisma/client": "^6.12.0",
    "@supabase/supabase-js": "^2.57.4",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "bcryptjs": "^3.0.2",
    "fflate": "0.8.3",
    "file-type": "^22.1.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "jose": "^6.1.0",
    "next": "16.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "sharp": "^0.35.5",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prisma": "^6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.71.2"
  }
}
