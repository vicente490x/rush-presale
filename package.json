{
  "name": "rush-presale",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --import ./scripts/load-test-env.ts --experimental-test-coverage --test tests/*.test.ts",
    "test:setup": "tsx scripts/setup-test-env.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "admin:setup": "tsx scripts/setup-local-admin.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:demo": "tsx prisma/seed.ts --demo",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "dependencies": {
    "@fal-ai/client": "^1.6.2",
    "@prisma/client": "^6.12.0",
    "@supabase/supabase-js": "^2.57.4",
    "@upstash/ratelimit": "^2.0.6",
    "@upstash/redis": "^1.35.3",
    "bcryptjs": "^3.0.2",
    "file-type": "^22.1.1",
    "framer-motion": "^12.23.12",
    "gsap": "^3.13.0",
    "jose": "^6.1.0",
    "next": "^16.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "resend": "^6.1.2",
    "sharp": "^0.35.5",
    "stripe": "^18.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.12.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
