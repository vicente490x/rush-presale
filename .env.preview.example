# Compatibilità con il precedente nome del modello; usare .env.staging.example.
# SOLO STAGING. Nessun segreto in questo modello.
APP_ENV=staging
NEXT_PUBLIC_SITE_URL=https://dominio-staging.example.invalid

# Database PostgreSQL NUOVO e indipendente. Pool per runtime, URL diretto per migrazioni.
DATABASE_URL=
DIRECT_URL=
# Impostare true SOLO dopo avere verificato che non sia il database dei clienti.
STAGING_DATABASE_CONFIRMED=false

# Esclusivamente sk_test_. In sviluppo e staging le chiavi live vengono rifiutate.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ALLOW_LIVE_PAYMENTS=false

# Generare con npm run staging:credentials; nessuna password in chiaro su Vercel.
ADMIN_ID=rush-admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=
ENABLE_AUTOMATIC_JOBS=false

# Inizializza i destinatari admin nel DB al primo accesso; poi usare /admin/impostazioni.
ADMIN_EMAIL=
RESEND_API_KEY=
MAIL_FROM=
# Lista ESATTA di email di test autorizzate, separate da virgola.
# Limita sia i nuovi ordini staging sia l'invio delle email non-production.
EMAIL_ALLOWLIST=

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AI esclusa dalla demo: non impostare chiavi fal.ai/Supabase.
TRYON_REVIEWED=false
