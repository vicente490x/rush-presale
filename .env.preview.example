APP_ENV=preview
NEXT_PUBLIC_SITE_URL=https://<preview-domain>
DATABASE_URL=<postgres-connection-pool-url>
DIRECT_URL=<postgres-direct-url>
PRESALE_THRESHOLD=15
PRESALE_MAX_QUANTITY=5
STRIPE_SECRET_KEY=<sk_test_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<strong-admin-password>
ADMIN_PASSWORD_HASH=<bcrypt-hash-from-create-admin>
SESSION_SECRET=<random-secret-at-least-32-characters>
CRON_SECRET=<random-cron-secret>
EMAIL_ALLOWLIST=<comma-separated-approved-email-addresses>
RESEND_API_KEY=<resend-api-key>
MAIL_FROM=<verified-sender-address>
TURNSTILE_SITE_KEY=<cloudflare-turnstile-site-key>
TURNSTILE_SECRET_KEY=<cloudflare-turnstile-secret>
UPSTASH_REDIS_REST_URL=<upstash-rest-url>
UPSTASH_REDIS_REST_TOKEN=<upstash-rest-token>
TRYON_PROVIDER_MODE=MOCK
TRYON_RESULT_TTL_SECONDS=300
SUPABASE_URL=<supabase-project-url>
SUPABASE_SERVICE_ROLE_KEY=<supabase-service-role-key>
TRYON_BUCKET=rush-tryon-temp
FAL_KEY=<fal-api-key>
TRYON_MODEL_ID=fal-ai/fashn/tryon
TRYON_DAILY_LIMIT=50
TRYON_MAX_DAILY_SPEND_USD=5
TRYON_COST_ESTIMATE_USD=0.075
